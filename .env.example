# Modelo do .env (versionado). Copie para .env e preencha; o .env fica fora do git.
# Lido pela aplicação (spring.config.import em application.properties) e pelo docker compose.
# Variáveis de ambiente do sistema têm prioridade sobre este arquivo.

# Banco (docker-compose.yml e spring.datasource)
DB_USER=rag
DB_PASSWORD=rag
# Opcional; padrão jdbc:postgresql://localhost:5432/ragdb
#DB_URL=jdbc:postgresql://localhost:5432/ragdb

# Chaves (obrigatórias para subir a aplicação)
OPENAI_API_KEY=
ADMIN_API_KEY=

# Opcional; padrão true
#SWAGGER_ENABLED=true
